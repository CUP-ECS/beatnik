# single_mode_large.in — large-scale single-mode sech2 rollup driven by
# Canopy's FMM BR solver. Same physics as single_mode.in, but scaled up
# to a 16000x16000 mesh. The bounding box and initial-condition geometry
# are scaled linearly with the mesh resolution from the 64-node baseline
# (bbox=1.0, period=9.0, magnitude=0.1) so the rollup occupies the same
# fraction of the domain as in the small case.
#
# Scaling rule (from 64 nodes / bbox=1.0 baseline):
#   bbox      = nodes / 64           (16000/64  = 250.0)
#   period    = 9.0  * (bbox / 1.0)  (9 * 250   = 2250)
#   magnitude = 0.1  * (bbox / 1.0)  (0.1 * 250 = 25.0)
#
# Run (tuolumne — fill in rank/node count for the target allocation):
#   flux run --ntasks=N --nodes=M --gpus-per-task=1 \
#       rocketrig examples/01_rocketrig/single_mode_large.in

# --- mesh / domain ---
nodes                = 16000
bounding_box         = 250.0

# --- initial condition: single-mode sech2 rollup, scaled to domain ---
initial_condition    = sech2
magnitude            = 25.0
period               = 2250.0
atwood               = 0.15

# --- physics / boundary ---
boundary             = free      # FmmBRSolver does not support periodic in v1

# --- solver: high-order Z-model + FMM BR solver ---
solver_order         = high
br_solver            = fmm
mu                   = 2.0
epsilon              = 2.0

# --- time integration ---
timesteps            = 300
write_frequency      = 10

# --- FMM tunables: leave at Beatnik defaults for production-scale runs.
#     Override here only if profiling indicates a need.
