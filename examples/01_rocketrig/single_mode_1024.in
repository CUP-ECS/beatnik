# single_mode_1024.in — physics-verification single-mode sech2 rollup
# driven by Canopy's FMM BR solver, at a 1024x1024 mesh (B = 16). Sized
# to actually reach a visible rollup so we can confirm the IC + dynamics
# scale correctly before committing to the much larger production meshes.
#
# Geometry scaling (from 64 nodes / bbox=1.0 baseline). Domain is (-B..B)
# centered on the origin; the sech2 IC is
#   z = magnitude * sech^2(period * r^2),  r = physical dist from center,
# so the bump's physical half-width is ~1/sqrt(period). To keep the bump
# the same FRACTION of a domain whose half-width B grows linearly:
#   B         = nodes / 64           (1024/64    = 16.0)
#   magnitude = 0.1  * B             (0.1 * 16    = 1.6)     [vertical amp, ~linear in B]
#   period    = 9.0  / B^2           (9 / 16^2    = 0.03515625)  [INVERSE square]
#
# Time integration. A geometrically larger domain has HIGHER interface
# velocities (v ~ sqrt(A*g*lambda), lambda ~ B => v ~ sqrt(B)), so with
# dx held fixed the CFL-stable step SHRINKS as ~1/sqrt(B). Do NOT inflate
# delta_t to evolve faster -- that triggers a CFL blowup once the (zero-
# initial) vorticity builds enough velocity, with the surface still flat.
#   tau                 = 1/sqrt(0.15 * 25*9.81)  = 0.16487
#   small-case auto dt  = tau/50                  = 0.0032975  (B=1)
#   peak-stable dt @B=16 ~ auto/sqrt(16)          = 0.000824
#   here delta_t        = 0.0006                  (margin under the peak limit)
# Rollup needs physical time ~sqrt(B) * small-case (~0.33) = ~1.3; full
# rollup at dt=0.0006 is ~2200 steps. 1500 steps (physical time 0.9 ~
# 5.5 tau) reaches well into the nonlinear rollup -- extend if you want
# the fully developed spiral.
#
# Run (tuolumne — fill in rank/node count for the target allocation):
#   flux run --ntasks=N --nodes=M --gpus-per-task=1 \
#       rocketrig examples/01_rocketrig/single_mode_1024.in

# --- mesh / domain ---
nodes                = 1024
bounding_box         = 16.0

# --- initial condition: single-mode sech2 rollup, scaled to domain ---
initial_condition    = sech2
magnitude            = 1.6
period               = 0.03515625
atwood               = 0.15

# --- physics / boundary ---
boundary             = free      # FmmBRSolver does not support periodic in v1

# --- solver: high-order Z-model + FMM BR solver ---
solver_order         = high
br_solver            = fmm
mu                   = 2.0
epsilon              = 2.0

# --- time integration (see header for the CFL reasoning) ---
delta_t              = 0.0006
timesteps            = 1500
write_frequency      = 20

# --- FMM tunables ---
fmm_ncrit             = 64       # default 32
fmm_max_depth         = 12       # default 15
fmm_mac_theta         = 0.6      # default 0.5
fmm_replication_depth = 2        # default 3
fmm_imbalance_tol     = 0.20     # default 0.10
fmm_ncrit_tol         = 0.15     # default 0.10

# Asymmetric bbox padding: tighter on the bottom faces, looser on top.
fmm_xmin_tol          = 0.15
fmm_xmax_tol          = 0.15
fmm_ymin_tol          = 0.15
fmm_ymax_tol          = 0.15
fmm_zmin_tol          = 0.15
fmm_zmax_tol          = 0.50
