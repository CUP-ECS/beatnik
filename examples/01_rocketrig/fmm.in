# fmm.in — small free-boundary sech2 rollup driven by Canopy's FMM
# BR solver. Mirrors the high-order rollup example in README.md, but
# with `br_solver = fmm` (requires Beatnik built with +canopy) and a
# few FMM tunables nudged off their defaults so the banner echo
# confirms they reached `Params`.
#
# Run (tuolumne, 4 ranks, 1 node):
#   flux run --ntasks=4 --nodes=1 --gpus-per-task=1 \
#       rocketrig examples/01_rocketrig/fmm.in

# --- mesh / domain ---
nodes                = 64
bounding_box         = 1.0

# --- initial condition: single-mode sech2 rollup ---
initial_condition    = sech2
magnitude            = 0.1
period               = 9.0
atwood               = 0.15

# --- physics / boundary ---
boundary             = free      # FmmBRSolver does not support periodic in v1

# --- solver: high-order Z-model + FMM BR solver ---
solver_order         = high
br_solver            = fmm
mu                   = 2.0
epsilon              = 2.0

# --- FMM tunables nudged off defaults so the banner echo verifies
#     the .in -> Params plumbing end-to-end. Asymmetric bbox tols
#     also exercise the per-face split. ---
fmm_ncrit             = 64       # default 32
fmm_max_depth         = 12       # default 15
fmm_mac_theta         = 0.6      # default 0.5
fmm_replication_depth = 2        # default 3
fmm_imbalance_tol     = 0.20     # default 0.10
fmm_ncrit_tol         = 0.15     # default 0.10

# Asymmetric bbox padding: tighter on the bottom faces, looser on top.
fmm_xmin_tol          = 0.05
fmm_xmax_tol          = 0.15
fmm_ymin_tol          = 0.05
fmm_ymax_tol          = 0.15
fmm_zmin_tol          = 0.05
fmm_zmax_tol          = 0.15
