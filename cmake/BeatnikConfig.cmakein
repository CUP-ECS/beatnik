include(CMakeFindDependencyMacro)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}" )
list(APPEND CMAKE_PREFIX_PATH @CMAKE_PREFIX_PATH@)
find_dependency(MPI REQUIRED CXX)
find_dependency(Kokkos REQUIRED)
find_dependency(Cabana REQUIRED COMPONENTS Cabana::Grid Cabana::Core)
find_dependency(SILO REQUIRED)
include("${CMAKE_CURRENT_LIST_DIR}/Beatnik_Targets.cmake")
